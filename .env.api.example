API_HOST=127.0.0.1
API_PORT=4000
FRONTEND_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Hosted PostgreSQL (copy your provider connection string)
DATABASE_URL=
# Hosted Redis must use TLS (rediss://); leave empty for local structural-only mode
REDIS_URL=
# Generate server secrets with npm run setup:server
RATE_LIMIT_SECRET=
FETCH_SERVICE_TOKEN=
# External checks default off; never expose these as NEXT_PUBLIC variables
ENABLE_REPUTATION=false
GOOGLE_SAFE_BROWSING_API_KEY=
ENABLE_REDIRECT_INSPECTION=false
NETWORK_ISOLATION_CONFIRMED=false
FETCH_SERVICE_URL=http://127.0.0.1:4010
FETCH_SERVICE_HOST=127.0.0.1
FETCH_SERVICE_PORT=4010
# Set only to the explicit CIDRs of a trusted reverse proxy when hosting later
TRUST_PROXY_CIDRS=
# Global queued-mode daily provider-call ceilings; timeouts/budget failures become unavailable checks
REPUTATION_DAILY_LIMIT=1000
INSPECTION_DAILY_LIMIT=500
